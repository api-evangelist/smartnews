{
  "opencollection": "1.0.0",
  "info": {
    "name": "SmartNews Marketing ad developer-app API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "developer-app",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of ad accounts associated with a specific developer app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ads.smartnews.com/api/bm/v1/developer_apps/me/ad_accounts"
          },
          "docs": "Get a list of ad accounts associated with a specific developer app."
        }
      ]
    }
  ],
  "bundled": true
}