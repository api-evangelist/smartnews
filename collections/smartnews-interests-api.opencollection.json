{
  "opencollection": "1.0.0",
  "info": {
    "name": "SmartNews Marketing ad interests API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "interests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Interests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ads.smartnews.com/api/ma/v3/iab_interest_categories"
          },
          "docs": "Returns an array of IAB interest categories which can be used for AdGroup level interest targeting.\n"
        }
      ]
    }
  ],
  "bundled": true
}