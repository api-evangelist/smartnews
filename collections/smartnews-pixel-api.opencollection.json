{
  "opencollection": "1.0.0",
  "info": {
    "name": "SmartNews Marketing ad pixel API",
    "version": "3.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "pixel",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of pixels which are linked to the ad_account_id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ads.smartnews.com/api/ma/v3/ad_accounts/:ad_account_id/pixels",
            "params": [
              {
                "name": "ad_account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "- Get list of pixels which are linked to the ad_account_id.\n"
        },
        {
          "info": {
            "name": "Get the details of the pixel_tag_id linked to the ad_account_id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ads.smartnews.com/api/ma/v3/ad_accounts/:ad_account_id/pixels/:pixel_tag_id",
            "params": [
              {
                "name": "ad_account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "pixel_tag_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "- It will return the details of the pixel_tag_id\n- The pixel_tag_id should be linked to ad_account_id, Otherwise returns 404\n"
        }
      ]
    }
  ],
  "bundled": true
}